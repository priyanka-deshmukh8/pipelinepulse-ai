# Local default uses SQLite. For PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://pipelinepulse:pipelinepulse@localhost:5432/pipelinepulse
DATABASE_URL=sqlite:///./pipelinepulse.db

# Optional Azure OpenAI configuration. Leave blank to use deterministic local fallback.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
